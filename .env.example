# DeGaJaFinance 시크릿 템플릿 — 이 파일을 `.env` 로 복사하고 값을 채운다.
# .env 는 .gitignore 로 커밋 금지(값은 여기 넣지 말 것 — 키 이름만).

# ── 뉴스 API (서버 PC 분리 구조) ──────────────────────────
# 서버 PC 자신은 비운다(로컬 DB 직접). 클라이언트만 서버 IP:PORT 를 넣는다.
DEGAJA_NEWS_API=
DEGAJA_NEWS_API_PORT=8787
# 데이터 디렉토리 이동 시(기본 ./data)
# DEGAJA_DATA_DIR=

# ── 텔레그램 봇(알림) ─────────────────────────────────────
BOT_TOKEN=
ADMIN_USER_ID=

# ── LLM ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ── 네이버(밸류에이션/뉴스) ───────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 차트 API ──────────────────────────────────────────────
CHART_API_BASE=

# ── 공시/거시 ─────────────────────────────────────────────
DART_API_KEY=
FRED_API_KEY=
DATA_GO_KR_KEY=

# ── 한국투자증권(KIS) ─────────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── KRX / 타임폴리오 ──────────────────────────────────────
KRX_ID=
KRX_PW=
TIMEFOLIO_EMAIL=
TIMEFOLIO_PASSWORD=

# ── 배치 ──────────────────────────────────────────────────
MAX_PROCESS_PER_RUN=
